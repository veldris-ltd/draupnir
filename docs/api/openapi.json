{
  "components": {
    "schemas": {
      "Health": {
        "description": "Liveness answer.",
        "properties": {
          "site_id": {
            "title": "Site Id",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "site_id"
        ],
        "title": "Health",
        "type": "object"
      },
      "Problem": {
        "description": "An RFC 9457 problem document.",
        "properties": {
          "code": {
            "description": "Machine readable, stable problem code.",
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Explanation for this occurrence.",
            "title": "Detail"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "URI of this occurrence.",
            "title": "Instance"
          },
          "status": {
            "description": "HTTP status code.",
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "description": "Short, human readable summary.",
            "title": "Title",
            "type": "string"
          },
          "type": {
            "description": "Stable URI identifying the problem type.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      },
      "Readiness": {
        "description": "Readiness answer, one entry per dependency.",
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "boolean"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ready",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "Readiness",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "\nThe DRAUPNIR control plane API.\n\nErrors are RFC 9457 problem documents served as `application/problem+json`.\nMutating endpoints accept an `Idempotency-Key`. Collections are cursor\npaginated. Mutable resources carry an `ETag` and require `If-Match`.\n",
    "summary": "CIM-56 model factory control plane",
    "title": "DRAUPNIR",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Return liveness. This touches no dependency by design.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "description": "An RFC 9457 problem document.",
                  "properties": {
                    "code": {
                      "description": "Machine readable, stable problem code.",
                      "title": "Code",
                      "type": "string"
                    },
                    "detail": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "Explanation for this occurrence.",
                      "title": "Detail"
                    },
                    "instance": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "URI of this occurrence.",
                      "title": "Instance"
                    },
                    "status": {
                      "description": "HTTP status code.",
                      "title": "Status",
                      "type": "integer"
                    },
                    "title": {
                      "description": "Short, human readable summary.",
                      "title": "Title",
                      "type": "string"
                    },
                    "type": {
                      "description": "Stable URI identifying the problem type.",
                      "title": "Type",
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code"
                  ],
                  "title": "Problem",
                  "type": "object"
                }
              }
            },
            "description": "An RFC 9457 problem document"
          }
        },
        "summary": "Liveness",
        "tags": [
          "operations"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Return readiness, having checked each dependency.\n\nSAD 11.2 requires degraded modes to be visible rather than fatal, so a\nfailed dependency reports `degraded` rather than raising.",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "description": "An RFC 9457 problem document.",
                  "properties": {
                    "code": {
                      "description": "Machine readable, stable problem code.",
                      "title": "Code",
                      "type": "string"
                    },
                    "detail": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "Explanation for this occurrence.",
                      "title": "Detail"
                    },
                    "instance": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "URI of this occurrence.",
                      "title": "Instance"
                    },
                    "status": {
                      "description": "HTTP status code.",
                      "title": "Status",
                      "type": "integer"
                    },
                    "title": {
                      "description": "Short, human readable summary.",
                      "title": "Title",
                      "type": "string"
                    },
                    "type": {
                      "description": "Stable URI identifying the problem type.",
                      "title": "Type",
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code"
                  ],
                  "title": "Problem",
                  "type": "object"
                }
              }
            },
            "description": "An RFC 9457 problem document"
          }
        },
        "summary": "Readiness",
        "tags": [
          "operations"
        ]
      }
    }
  }
}
