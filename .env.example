# Copy to .env for local development. `make dev` does this for you.
# Nothing in this file is a real credential; the development stack is
# ephemeral and reachable only from localhost.

DRAUPNIR_ENV=development
DRAUPNIR_SITE_ID=sindri

# PostgreSQL 16 (SAD 7.2 -- ledger and projection)
DRAUPNIR_DATABASE_URL=postgresql+asyncpg://draupnir:draupnir@localhost:5432/draupnir
DRAUPNIR_DATABASE_URL_SYNC=postgresql+psycopg://draupnir:draupnir@localhost:5432/draupnir

# MinIO (SAD 7.2 -- artefact object store)
DRAUPNIR_OBJECT_STORE_ENDPOINT=localhost:9000
DRAUPNIR_OBJECT_STORE_ACCESS_KEY=draupnir
DRAUPNIR_OBJECT_STORE_SECRET_KEY=draupnir-dev-secret
DRAUPNIR_OBJECT_STORE_BUCKET=draupnir
DRAUPNIR_OBJECT_STORE_SECURE=false

# Edge
DRAUPNIR_API_HOST=127.0.0.1
DRAUPNIR_API_PORT=8000
DRAUPNIR_LOG_LEVEL=info
