# Copy to .env for local development. `make dev` does this for you.
# Nothing in this file is a real credential; the development stack is
# ephemeral and reachable only from this machine.
#
# 127.0.0.1 rather than `localhost`: on Windows `localhost` resolves to ::1
# first, the containers publish on IPv4 only, and a driver with no connect
# timeout waits out the v6 attempt. It presents as one code path hanging
# while another works, which is a long way from its cause.

DRAUPNIR_ENV=development
DRAUPNIR_SITE_ID=sindri

# PostgreSQL 16 (SAD 7.2 -- ledger and projection)
DRAUPNIR_DATABASE_URL=postgresql+asyncpg://draupnir:draupnir@127.0.0.1:5432/draupnir
DRAUPNIR_DATABASE_URL_SYNC=postgresql+psycopg://draupnir:draupnir@127.0.0.1:5432/draupnir

# MinIO (SAD 7.2 -- artefact object store)
DRAUPNIR_OBJECT_STORE_ENDPOINT=127.0.0.1:9000
DRAUPNIR_OBJECT_STORE_ACCESS_KEY=draupnir
DRAUPNIR_OBJECT_STORE_SECRET_KEY=draupnir-dev-secret
DRAUPNIR_OBJECT_STORE_BUCKET=draupnir
DRAUPNIR_OBJECT_STORE_SECURE=false

# Edge
DRAUPNIR_API_HOST=127.0.0.1
DRAUPNIR_API_PORT=8000
DRAUPNIR_LOG_LEVEL=info

# Authentication (SAD 9.3, RF-01)
#
# The API refuses to start unless it has either a way to verify a token or an
# explicit development principal. A control plane that starts with no way to
# authenticate anybody answers 401 to everything, which reads as a broken
# deployment rather than as a missing setting.
#
# On a developer's machine there is no MEGINGJORD, so the concession is the
# development principal: it verifies nothing, reads no header, and cannot be
# persuaded to trust one. Never set it where real data is held.
DRAUPNIR_DEV=1
DRAUPNIR_DEV_ROLES=viewer,curator,operator,approver,admin

# At a forge, delete the two lines above and set these instead. The JWKS URL is
# derived from the issuer by the discovery convention when it is left empty.
# DRAUPNIR_OIDC_ISSUER=https://megingjord.veldris.internal
# DRAUPNIR_OIDC_AUDIENCE=draupnir-control-plane
# DRAUPNIR_OIDC_JWKS_URL=
# DRAUPNIR_OIDC_LEEWAY_SECONDS=60
