[Unit]
Description=DRAUPNIR console (control plane, @SITE_ID@)
Documentation=https://github.com/veldris-ltd/draupnir/blob/main/docs/runbook.md
# Static assets behind the API (SAD 11 component table). It is deliberately
# not ordered after draupnir-api: the console renders its own error surface
# when the API is down (AC-U14), and that is more use to an operator than a
# console which is simply missing.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@LIBEXEC@/draupnir-run.sh draupnir-web
ExecStop=@PODMAN@ stop --ignore --time=20 draupnir-web
ExecStopPost=@PODMAN@ rm --ignore --force draupnir-web
# The stale-name clean that used to be an ExecStartPre here is now in
# draupnir-run.sh, so that the launchd agent of the same unit gets it too:
# launchd has no pre-start hook, and one copy of the rule is better than four.
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

[Install]
WantedBy=default.target
